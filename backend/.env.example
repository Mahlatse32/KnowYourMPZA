# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://knowyourmpza:knowyourmpza@localhost:5432/knowyourmpza

# Comma-separated list of allowed CORS origins.
# For production set this to your deployed frontend URL.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ── Ingestion guards ──────────────────────────────────────────────────────────
# Set INGESTION_ENABLED=true only in a production environment with a real
# database. Leaving it unset or false prevents scheduled ingestion from running.
INGESTION_ENABLED=false

# Seconds to sleep between source requests. Respect public source rate limits.
SOURCE_RATE_LIMIT_SLEEP=0.5

# Maximum URLs processed per scheduled daily run.
MAX_DAILY_INGESTION_URLS=100

# Maximum URLs processed per scheduled weekly run.
MAX_WEEKLY_INGESTION_URLS=500

# ── Archive storage ───────────────────────────────────────────────────────────
# local = store raw HTML/PDF archives on disk (default, fine for development)
# For production you may implement an S3-compatible backend.
ARCHIVE_STORAGE_MODE=local
ARCHIVE_BASE_PATH=data/raw

# ── People's Assembly source URLs (optional overrides) ───────────────────────
# PEOPLE_ASSEMBLY_BASE_URL=https://www.pa.org.za
# PEOPLE_ASSEMBLY_MEMBER_LIST_URLS=https://www.pa.org.za/position/member/parliament/
